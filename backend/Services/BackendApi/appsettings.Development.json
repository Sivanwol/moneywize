{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5082",
          "http://localhost:5081",
          "http://localhost:5083"
        ],
        "ValidIssuer": "application-api-security"
      }
    }
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "Local Front Api Health Check",
        "Uri": "http://localhost:5082/healthz"
      }
    ],
    "Webhooks": [],
    "EvaluationTimeInSeconds": 10,
    "MinimumSecondsBetweenFailureNotifications": 60
  },
  "ConnectionStrings": {
    "DbConnection": "Server=localhost;Port=8889;Database=poc2;Uid=root;Pwd=root;"
  },
  "MailConfig": {
    "FromAddress": "dev@wolberg.pro",
    "DisplayName": "Wolberg",
    "ServerAddress": "localhost",
    "Port": 1025,
    "IsUseSsl": false,
    "IsStartTls": false,
    "IsUseCredentials": false,
    "Username": "",
    "Password": ""
  },
  "ApplicationConfig": {
    "ApiName": "Backend Api",
    "connectionString": "",
    "APIMajorVersion": "1",
    "APIMinorVersion": "0",
    "EnableSwagger": true,
    "DisableHealthCheck": true,
    "RabbitMqHost": "localhost",
    "RabbitMqUsername": "guest",
    "RabbitMqPassword": "guest",
    "RabbitMqVirtualHost": "/",
    "JwtIssuer": "application-api-security",
    "JwtAudience": "http://localhost:3000",
    "JwtSecret": "application-api-security",
    "JwtAccessTokenExpired": 6400,
    "JwtRefreshTokenExpired": 86400
  },
  "FeatureManagement": {
    "FeatureA": true
  }
}
